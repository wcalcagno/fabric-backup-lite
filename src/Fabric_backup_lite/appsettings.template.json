{
  "Authentication": {
    "ClientId": "YOUR-AZURE-AD-APP-CLIENT-ID",
    "TenantId": "YOUR-TENANT-ID-OR-common",
    "RedirectUri": "http://localhost",
    "Scopes": [
      "https://analysis.windows.net/powerbi/api/Workspace.Read.All",
      "https://analysis.windows.net/powerbi/api/Item.Read.All",
      "https://analysis.windows.net/powerbi/api/Workspace.ReadWrite.All",
      "https://analysis.windows.net/powerbi/api/Item.ReadWrite.All"
    ]
  },
  "Fabric": {
    "BaseUrl": "https://api.fabric.microsoft.com/v1/",
    "Timeout": 120,
    "RetryAttempts": 3,
    "LROPollingInterval": 2000
  },
  "Backup": {
    "DefaultDestination": "",
    "SupportedItemTypes": [
      "Report",
      "SemanticModel",
      "Notebook",
      "DataPipeline",
      "Dataflow",
      "Lakehouse",
      "KQLDatabase",
      "Eventhouse",
      "Environment",
      "SparkJobDefinition",
      "Warehouse",
      "Eventstream",
      "Reflex",
      "VariableLibrary",
      "MirroredDatabase",
      "KQLDashboard",
      "KQLQueryset",
      "GraphQLApi",
      "CopyJob",
      "PaginatedReport"
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fabric-backup-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
