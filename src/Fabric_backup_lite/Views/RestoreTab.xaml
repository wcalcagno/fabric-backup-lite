<UserControl x:Class="Fabric_backup_lite.Views.RestoreTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Fabric_backup_lite.Models"
             Background="#F0F2F5">

    <UserControl.Resources>
        <!-- Grouped view of ManifestItems, keyed by ItemType enum -->
        <CollectionViewSource x:Key="GroupedItems" Source="{Binding ManifestItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="ItemType"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Primary blue brush (matches MainWindow) -->
        <SolidColorBrush x:Key="PrimaryBrush"    Color="#0B5394"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1A6BB5"/>
        <SolidColorBrush x:Key="BorderBrush"     Color="#DDE1E7"/>
        <SolidColorBrush x:Key="SurfaceBrush"    Color="#FFFFFF"/>

        <!-- Card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="12"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- Card section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="#374151"/>
            <Setter Property="Margin"         Value="0,0,0,6"/>
        </Style>

        <!-- Action button base -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"         Value="34"/>
            <Setter Property="Padding"        Value="14,0"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small toolbar button -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height"   Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="10,0"/>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Two-column layout: left (item list) | splitter | right (ctrl) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  LEFT PANEL — item list                                   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#DDE1E7"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Panel header -->
                <Border Grid.Row="0"
                        Background="{StaticResource PrimaryBrush}"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding L.RestoreExplorerHeader}"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedItemsInfo}"
                                   Foreground="#AACCEE"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Toolbar: Select All / None -->
                <Border Grid.Row="1"
                        Background="#F8FAFB"
                        BorderBrush="#DDE1E7"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="{Binding L.SelectAllButton}"
                                Command="{Binding SelectAllItemsCommand}"
                                Style="{StaticResource ToolbarButton}"
                                Background="#E8F4EA"
                                Foreground="#1A5C2E"
                                Margin="0,0,6,0"/>
                        <Button Content="{Binding L.SelectNoneButton}"
                                Command="{Binding DeselectAllItemsCommand}"
                                Style="{StaticResource ToolbarButton}"
                                Background="#FDE8E8"
                                Foreground="#9B1C1C"/>
                    </StackPanel>
                </Border>

                <!-- Item list with grouping -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="0">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedItems}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#F0F4F8"
                                                BorderBrush="#DDE1E7"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,5">
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="11.5"
                                                       Foreground="#374151">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}  ({1})">
                                                        <Binding Path="Name"/>
                                                        <Binding Path="ItemCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RestoreItemViewModel}">
                                <Border Padding="10,4" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsRestorable}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestorable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBlock Text="{Binding TypeIcon}"
                                                   FontSize="13"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestorable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TooltipText}">
                                            <TextBlock.Text>
                                                <Binding Path="Item.Name"/>
                                            </TextBlock.Text>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestorable}" Value="False">
                                                            <Setter Property="Opacity"    Value="0.5"/>
                                                            <Setter Property="FontStyle"  Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="#DDE1E7"
                      Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  RIGHT PANEL — controls                                   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Margin="12,12,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Source folder card -->
                <RowDefinition Height="Auto"/>  <!-- Destination workspace card -->
                <RowDefinition Height="*"/>     <!-- Activity log -->
                <RowDefinition Height="Auto"/>  <!-- Progress -->
                <RowDefinition Height="Auto"/>  <!-- Action row -->
            </Grid.RowDefinitions>

            <!-- ── Card 1: Source folder ── -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding L.SourceFolderLabel}"
                               Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SourceRootFolder, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="12"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 Background="#F9FAFB"
                                 BorderBrush="#DDE1E7"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="1"
                                Content="{Binding L.BrowseButton}"
                                Command="{Binding BrowseSourceFolderCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#EEF2FF"
                                Foreground="#4338CA"
                                Width="90"/>
                    </Grid>

                    <TextBlock Text="{Binding L.DiscoveredBackupsLabel}"
                               Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding DiscoveredBackups}"
                              SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                              DisplayMemberPath="DisplayLabel"
                              FontSize="12"
                              Padding="6,4"
                              Height="30"/>
                </StackPanel>
            </Border>

            <!-- ── Card 2: Destination workspace ── -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding L.DestWorkspaceLabel}"
                               Style="{StaticResource SectionLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableWorkspaces}"
                              SelectedItem="{Binding SelectedDestinationWorkspace, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              FontSize="12"
                              Padding="6,4"
                              Height="30"
                              Margin="0,0,0,8"/>

                    <!-- New workspace fields (visible only when IsNewWorkspace = true) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding L.NewWorkspaceNameLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#1E40AF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,6"
                                           Width="130"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding NewWorkspaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         Padding="6,4"
                                         BorderBrush="#93C5FD"
                                         Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding L.CapacityLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#1E40AF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Width="130"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding AvailableCapacities}"
                                          SelectedItem="{Binding SelectedCapacity, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          FontSize="12"
                                          Padding="6,4"
                                          Height="30"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Card 3: Activity log ── -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding L.ActivityLogLabel}"
                               Style="{StaticResource SectionLabel}"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  MinHeight="80"
                                  x:Name="RestoreLogScroll">
                        <ItemsControl ItemsSource="{Binding LogMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               Foreground="#1F2937"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Card 4: Progress ── -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Minimum="0"
                                 Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue}"
                                 Height="8"
                                 Background="#E5E7EB"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRestoreInProgress}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- ── Action row ── -->
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedItemsInfo}"
                           FontSize="12"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="{Binding L.StartRestoreButton}"
                        Command="{Binding StartRestoreCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#16A34A"
                        Foreground="White"
                        Width="160"
                        Margin="8,0"/>

                <Button Grid.Column="2"
                        Content="{Binding L.CancelButton}"
                        Command="{Binding CancelRestoreCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#DC2626"
                        Foreground="White"
                        Width="100"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
